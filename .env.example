# =============================================================================
# WhatsApp Bridge Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# 
# Get these from: https://developers.facebook.com/ → Your App → WhatsApp
# =============================================================================

# Your WhatsApp Business Phone Number ID
# Found in: WhatsApp → Getting Started → Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Your permanent access token
# Found in: WhatsApp → Getting Started → Generate Access Token
WHATSAPP_ACCESS_TOKEN=your_access_token_here

# Your personal WhatsApp number (with country code, no + or spaces)
# Example: 919876543210 for India (+91)
# This is used to verify only YOUR messages trigger the agent
MY_WHATSAPP_NUMBER=your_phone_number_here

# Webhook verify token (choose any string you want)
# You'll enter this same string in Meta Developer Console
WEBHOOK_VERIFY_TOKEN=my_antigravity_bridge_token

# Project directory for the agy agent to work on ('auto' detects whichever folder is open in Antigravity IDE)
PROJECT_DIR=auto

# Agent model (optional, leave empty for default)
AGY_MODEL=

# Agent reasoning effort: low, medium, high
AGY_EFFORT=high

# Print timeout for agy CLI (how long to wait for agent response)
AGY_PRINT_TIMEOUT=10m0s

# =============================================================================
# ngrok Configuration (for automatic tunnel)
# =============================================================================

# Your ngrok auth token (free account)
# Get it from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Optional: Free static domain (so webhook URL never changes!)
# Get one from: https://dashboard.ngrok.com/domains
# Example: my-bridge-abc123.ngrok-free.app
NGROK_DOMAIN=

